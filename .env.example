# --- Banco (Neon Postgres, branch production) ---
# Obrigatorio. Schema e seed sao aplicados sozinhos no primeiro acesso.
DATABASE_URL=
DATABASE_POOL_MAX=4

# --- Site ---
# Nome das noivas exibido no site
WEDDING_NAMES="Jéssica & Jennifer"
WEDDING_DATE="2026-10-29"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin ---
# Obrigatório para habilitar a area administrativa. Gere um hash com:
#   npm run admin:password -- "sua senha forte"
ADMIN_PASSWORD_HASH=""

# --- Armazenamento de fotos ---
# local | drive
PHOTO_STORAGE="local"

# --- Pix ---
# manual | openpix
# manual: gera o Pix Copia e Cola por presente, com o valor ja preenchido (PIX_KEY)
# e confirmacao manual no painel. PIX_KEY_PAYLOAD e o fallback para um BR Code fixo.
PIX_PROVIDER="manual"
PIX_KEY=""
PIX_RECIPIENT_CITY="SAO PAULO"
PIX_KEY_PAYLOAD=""

# OpenPix (Pix dinamico + webhook automatico)
OPENPIX_API_KEY=""
OPENPIX_BASE_URL="https://api.openpix.dev/v1"
# Valor do header x-webhook-id enviado pelo OpenPix. Vazio = webhook desativado.
OPENPIX_WEBHOOK_TOKEN=""

# --- Google Drive ---
# Pasta de destino das fotos (https://drive.google.com/drive/u/0/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID="1BxFLKSC8o0MezlAuuewodhnto1EMSz_o"
# OAuth da conta humana proprietaria da pasta (rode: npm run drive:auth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# --- Limites ---
MAX_PHOTO_BYTES="15728640"
RATE_LIMIT_PHOTOS_PER_HOUR="20"
RATE_LIMIT_PAYMENTS_PER_HOUR="40"